APP_NAME=OngekiScoreLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# 画面表示用のバージョン情報（Docker イメージの build-arg から渡される）
APPLICATION_VERSION=
COMMIT_HASH=
GITHUB_REPO_URL=https://github.com/project-primera/ongeki-score

# オンゲキ本体のバージョン（楽曲追加時に記録される）
ONGEKI_VERSION=1
ONGEKE_VERSION_DATE=2000/01/01

# true にするとスコア登録 API をメンテナンス中として扱う（管理者は除く）
IS_MAINTENANCE_API_USER_UPDATE=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ongeki-score
DB_USERNAME=root
DB_PASSWORD=

# 旧キー名（BROADCAST_DRIVER / CACHE_DRIVER / QUEUE_DRIVER / MAIL_DRIVER / FILESYSTEM_DRIVER）も引き続き読み込まれる
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_ENCRYPTION は接続方式には使われない。587 番は STARTTLS を自動適用。暗黙 TLS にする場合は MAIL_SCHEME=smtps と MAIL_PORT=465
MAIL_SCHEME=null
# STARTTLS で送れない中継への退避: MAIL_AUTO_TLS=false（旧版の MAIL_ENCRYPTION=null 相当）、MAIL_VERIFY_PEER=false
MAIL_AUTO_TLS=null
MAIL_VERIFY_PEER=null
# STARTTLS を必須にする（広告が無ければ平文に落とさず送信失敗）。未設定なら旧版どおり MAIL_ENCRYPTION（キー無し・tls で必須、null で任意）に従う。
# =null は未設定扱い（MAIL_ENCRYPTION に従う）。任意にしたいときは false、必須にしたいときは true を明示する
# MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Slack 通知先（未設定なら通知しない）
SLACK_WEBHOOK_URL_DEFAULT=
SLACK_WEBHOOK_URL_DEBUG=
SLACK_WEBHOOK_URL_INFO=
SLACK_WEBHOOK_URL_NOTICE=
SLACK_WEBHOOK_URL_WARNING=
SLACK_WEBHOOK_URL_ERROR=
SLACK_WEBHOOK_URL_CRITICAL=
SLACK_WEBHOOK_URL_ALERT=
SLACK_WEBHOOK_URL_EMERGENCY=
