{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "ES2017"],
        "types": ["vite/client", "jquery"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "strict": false,
        "removeComments": true
    },
    "include": [
        "resources/assets/js/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}
